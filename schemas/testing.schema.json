{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebGPU demo test results",
  "type": "object",
  "required": ["demos"],
  "additionalProperties": false,
  "properties": {
    "demos": {
      "description": "Demo repositories, named after their `source/demos/*.yml` file.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": ["object", "null"],
          "propertyNames": { "$ref": "#/$defs/target" },
          "additionalProperties": { "$ref": "#/$defs/run" }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "string",
      "pattern": "^(desktop-(linuxbsd|windows|macos)-(wgpu|dawn)|web-(linuxbsd|windows|macos)-(chromium|firefox)|web-macos-safari)$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mobile": { "$ref": "#/$defs/result" },
        "forward_plus": { "$ref": "#/$defs/result" }
      }
    },
    "result": {
      "description": "Leave status empty for untested, a set status needs a commit.",
      "type": "object",
      "required": ["commit", "status"],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "Godot commit this was tested at.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "status": { "enum": ["ok", "performance", "visual", "partial", "crash", "wip", null] },
        "note": { "type": ["string", "null"] }
      },
      "if": { "properties": { "status": { "type": "string" } } },
      "then": { "properties": { "commit": { "type": "string" } } }
    }
  }
}
